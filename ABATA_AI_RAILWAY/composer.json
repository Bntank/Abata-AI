{
 "name":"abata/reference-demo","type":"project","description":"ABATA AI standalone inventory demo",
 "require":{"php":"^8.3","laravel/framework":"^13.17"},
 "require-dev":{
  "mockery/mockery": "1.5",
  "phpunit/phpunit": "^12.5"
 },
 "autoload":{"psr-4":{"App\\":"app/","Database\\Seeders\\":"database/seeders/"}},
 "autoload-dev":{"psr-4":{"Tests\\":"tests/"}},
 "scripts":{"post-autoload-dump":["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump","@php artisan package:discover --ansi"]},
 "config":{"sort-packages":true,"optimize-autoloader":true,"preferred-install":"dist"},"prefer-stable":true
}
